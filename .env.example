# coffeeroom 鉴权（沿用旧配置）
BOT_USERNAME=your_bot_username
BOT_ACCESS_TOKEN=your_access_token
ROOM_NAME=minecraft
HTTP_BASE=https://room.caffeine.ink
LOGIN_URL=https://room.caffeine.ink/api/login

# alive-buddy 服务地址（docker compose 网络内）
ALIVE_BUDDY_HTTP_BASE=http://alive-buddy:3000
ALIVE_BUDDY_WS_BASE=ws://alive-buddy:3000

# LLM 供应商（通过 CharacterConfig 传给 alive-buddy）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash

# connector webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=9100
WEBHOOK_PUBLIC_URL=http://endra-connector:9100/webhook

# 回复冷却（秒）：冷却期内消息全部 silent 投递，只进记忆不耗 LLM
REPLY_COOLDOWN_SECONDS=15

# ---- 在场感知闸门：房间没人在线时，别对着空频道自言自语 ----
# 在线名单来源，默认 {HTTP_BASE}/api/online-users（coffeeroom 已提供，无需额外凭据）
PRESENCE_ENABLED=true
#PRESENCE_API_URL=https://room.caffeine.ink/api/online-users
# 在线名单缓存秒数（同时也是接口最小调用间隔）
PRESENCE_CACHE_TTL_SECONDS=60
PRESENCE_TIMEOUT_SECONDS=8
# 不计入"有人"的账号（MC 桥接机器人 / 其他 bot），逗号分隔、小写
#PRESENCE_IGNORE_USERS=mc-bridge,another-bot
# 名单未知（接口挂了/无 cookie）时：open=放行；quota=按空房间走静默配额（默认，防刷屏）
PRESENCE_FAIL_MODE=quota
# 距最近一条真人消息多久以内的发言算"回应"，空房间下也永远放行
PRESENCE_REACTIVE_WINDOW_SECONDS=180
# 空房间时，滚动窗口内允许的主动发言条数（0=完全静默）
QUIET_PROACTIVE_DAILY_QUOTA=1
QUIET_PROACTIVE_WINDOW_HOURS=24

# 联调期打开，可观测 reAct 思考流
DEBUG_REACT_LOG=true

# ---- 工具（萌娘百科 / Wikidata / 币价 / MCP）----
# 工具在 connector 侧执行，alive-buddy 只拿到 function 定义并回调 /tools/call
TOOLS_ENABLED=true
TOOL_TIMEOUT_SECONDS=12
# 工具结果长度上限：0 = 不截断（默认）。只有想压 token 成本时才设成具体字数
TOOL_RESULT_MAX_CHARS=0
TOOL_RATE_LIMIT_PER_MINUTE=6
TOOL_RATE_LIMIT_PER_DAY=200
TOOL_DAILY_TOTAL=300
# buddy 回调执行工具用的共享口令（留空=不校验，compose 内网可留空）
#TOOL_API_TOKEN=
# buddy 侧回调地址；留空则由 WEBHOOK_PUBLIC_URL 自动推导（把 /webhook 换成 /tools/call）
#TOOL_PUBLIC_URL=http://endra-connector:9100/tools/call

# 萌娘百科（实测可达）
MOEGIRL_ENABLED=true
MOEGIRL_API_BASE=https://zh.moegirl.org.cn/api.php

# 维基：走 Wikidata（实测可达）。维基百科正文域名在部署网络下不可达，
# 若你自备镜像/代理，把 WIKI_API_BASE 指过去（或改成你的 MediaWiki api.php）
WIKI_ENABLED=true
WIKI_API_BASE=https://www.wikidata.org/w/api.php
WIKI_LANG=zh

# 币价：Gate.io 主、CoinEx 备（CoinGecko/Binance/OKX 实测超时）
CRYPTO_ENABLED=true
CRYPTO_API_BASE=https://api.gateio.ws
CRYPTO_FALLBACK_BASE=https://api.coinex.com

# 可选 MCP server：JSON 数组。stdio 用 command/args，远程用 url。
# 工具名默认加 server 名前缀避免冲突；allow/deny 是可选的收窄手段（默认不限制）
#MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}]
#MCP_SERVERS=[{"name":"remote","url":"https://example.com/mcp"}]
MCP_TIMEOUT_SECONDS=20

# ---- LLM 采样（原先 penalty 拉满 1.0，反而让话更虚；这里改为中等强度）----
LLM_TEMPERATURE=0.9
LLM_TOP_P=0.95
LLM_PRESENCE_PENALTY=0.4
LLM_FREQUENCY_PENALTY=0.6

# ---- 记忆与上下文窗口（下发给 alive-buddy）----
MEMORY_L1_CAPACITY=40
MEMORY_CONTEXT_LIMIT=30
MEMORY_MONOLOGUE_BUDGET=1
MEMORY_EPISODE_LIMIT=3
MEMORY_IDLE_SUMMARIZE_MINUTES=120
