# coffeeroom 鉴权（沿用旧配置）
BOT_USERNAME=your_bot_username
BOT_ACCESS_TOKEN=your_access_token
ROOM_NAME=minecraft
HTTP_BASE=https://room.caffeine.ink
LOGIN_URL=https://room.caffeine.ink/api/login

# alive-buddy 服务地址（docker compose 网络内）
ALIVE_BUDDY_HTTP_BASE=http://alive-buddy:3000
ALIVE_BUDDY_WS_BASE=ws://alive-buddy:3000

# LLM 供应商（通过 CharacterConfig 传给 alive-buddy）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash

# connector webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=9100
WEBHOOK_PUBLIC_URL=http://endra-connector:9100/webhook

# 回复冷却（秒）：冷却期内消息全部 silent 投递，只进记忆不耗 LLM
REPLY_COOLDOWN_SECONDS=15

# ---- 在场感知闸门：房间没人在线时，别对着空频道自言自语 ----
# 在线名单来源，默认 {HTTP_BASE}/api/online-users（coffeeroom 已提供，无需额外凭据）
PRESENCE_ENABLED=true
# 第二个在场信号：MC 在线人数（RCON list）。玩家在游戏里但没开网页时，网页名单是空的，
# 单靠它会把"有人在"误判成空房间。两个信号取"或"。需要 MC_RCON_PASSWORD 才生效。
PRESENCE_USE_MC=true
# MC 在线名单里要排除的账号（如常驻机器人）
#PRESENCE_MC_IGNORE_USERS=
#PRESENCE_API_URL=https://room.caffeine.ink/api/online-users
# 在线名单缓存秒数（同时也是接口最小调用间隔）
PRESENCE_CACHE_TTL_SECONDS=60
PRESENCE_TIMEOUT_SECONDS=8
# 不计入"有人"的账号（MC 桥接机器人 / 其他 bot），逗号分隔、小写
#PRESENCE_IGNORE_USERS=mc-bridge,another-bot
# 名单未知（接口挂了/无 cookie）时：open=放行；quota=按空房间走静默配额（默认，防刷屏）
PRESENCE_FAIL_MODE=quota
# 距最近一条真人消息多久以内的发言算"回应"，空房间下也永远放行
PRESENCE_REACTIVE_WINDOW_SECONDS=180
# 空房间时，滚动窗口内允许的主动发言条数（0=完全静默）
QUIET_PROACTIVE_DAILY_QUOTA=1
QUIET_PROACTIVE_WINDOW_HOURS=24

# 联调期打开，可观测 reAct 思考流
DEBUG_REACT_LOG=true

# ---- 工具（萌娘百科 / Wikidata / 币价 / MCP）----
# 工具在 connector 侧执行，alive-buddy 只拿到 function 定义并回调 /tools/call
TOOLS_ENABLED=true
TOOL_TIMEOUT_SECONDS=12
# 工具结果长度上限：0 = 不截断（默认）。只有想压 token 成本时才设成具体字数
TOOL_RESULT_MAX_CHARS=0
TOOL_RATE_LIMIT_PER_MINUTE=6
TOOL_RATE_LIMIT_PER_DAY=200
TOOL_DAILY_TOTAL=300
# 熔断：某工具连续失败达阈值就停用一段时间，避免对着不通的数据源反复白等
# （每次超时都会白烧一个 timeout + 一轮 LLM）。0 = 关闭熔断
TOOL_CIRCUIT_THRESHOLD=3
TOOL_CIRCUIT_COOLDOWN_SECONDS=600
# buddy 回调执行工具用的共享口令（留空=不校验，compose 内网可留空）
#TOOL_API_TOKEN=
# buddy 侧回调地址；留空则由 WEBHOOK_PUBLIC_URL 自动推导（把 /webhook 换成 /tools/call）
#TOOL_PUBLIC_URL=http://endra-connector:9100/tools/call

# 萌娘百科（实测可达）
MOEGIRL_ENABLED=true
MOEGIRL_API_BASE=https://zh.moegirl.org.cn/api.php

# 维基：走 Wikidata（实测可达）。维基百科正文域名在部署网络下不可达，
# 若你自备镜像/代理，把 WIKI_API_BASE 指过去（或改成你的 MediaWiki api.php）
WIKI_ENABLED=true
WIKI_API_BASE=https://www.wikidata.org/w/api.php
WIKI_LANG=zh
# 可配置的 MediaWiki 源（JSON）。用来接部署网络上真正可达的 wiki，会自动注册
# <name>_search / <name>_page 两个工具。下面这条是 CN 可达的 Minecraft Wiki 镜像：
#MEDIAWIKI_SITES=[{"name":"mcwiki","api_base":"https://wiki.biligame.com/mc/api.php","label":"Minecraft Wiki"}]

# 币价：Gate.io 主、CoinEx 备（CoinGecko/Binance/OKX 实测超时）
CRYPTO_ENABLED=true
CRYPTO_API_BASE=https://api.gateio.ws
CRYPTO_FALLBACK_BASE=https://api.coinex.com

# 可选 MCP server：JSON 数组。stdio 用 command/args，远程用 url。
# 工具名默认加 server 名前缀避免冲突；allow/deny 是可选的收窄手段（默认不限制）
#MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}]
#MCP_SERVERS=[{"name":"remote","url":"https://example.com/mcp"}]
MCP_TIMEOUT_SECONDS=20

# ---- 只读 shell（威胁模型见 connector/tools/shell.py）----
# 白名单执行、不经 shell、子进程环境清洗、路径限定、超时+限流。
READONLY_SHELL_ENABLED=true
# 系统信息类命令（date/uptime/df/free/uname/whoami/id/nproc）不读文件，默认可用。
# 文件类命令（ls/cat/head/tail/wc/file/stat/du/grep/find/git）需显式开启：
READONLY_SHELL_ALLOW_FILES=false
# 可读根目录（compose 已把它只读挂载到 /app/data/readonly）
# 警告：放进来的一切等于允许 Endra 公开引用；.env/cookies.json/私钥/secrets/ 始终被拒绝
READONLY_SHELL_ROOT=/app/data/readonly
READONLY_SHELL_TIMEOUT_SECONDS=8
# 输出上限（防止 cat 大文件把上下文打爆）；0 = 不截断
READONLY_SHELL_MAX_OUTPUT=20000
#READONLY_SHELL_TZ=Asia/Shanghai
READONLY_SHELL_PER_MINUTE=3
READONLY_SHELL_PER_DAY=40

# ---- Minecraft 服务器（只读巡查 + 仅限 bot 的踢人）----
MC_ENABLED=true
# MC 跑在宿主机上（systemd mc.service），容器经 host.docker.internal 访问；
# 若解析不了就改成 docker 网桥网关（实测 172.17.0.1 可达）
MC_RCON_HOST=host.docker.internal
MC_RCON_PORT=25575
# 取自服务器的 server.properties: rcon.password（该文件在 /data/NEKO，root 可读）
MC_RCON_PASSWORD=
MC_RCON_TIMEOUT_SECONDS=5
# 踢人默认关闭；开启后也只有"被明确认定为 bot"的账号踢得动
MC_KICK_ENABLED=false
# 可踢的 bot：精确名单（逗号分隔）和/或名字正则；两者都空 = 谁都不能踢
MC_BOT_PLAYERS=
#MC_BOT_NAME_PATTERN=^[A-Za-z]+Bot\d*$
# 受保护名单：优先级最高，即使写进 bot 名单也踢不动。
# 这里只能"追加"：Cloudrayyy / QQQQiu_feng / khangai / Vterlong 写死在代码里，清空本行也删不掉
MC_PROTECTED_PLAYERS=Cloudrayyy,QQQQiu_feng,khangai,Vterlong
# 踢人后的事后通知（没有人工审批，至少让你事后看得见）；留空则不通知
#MC_KICK_NOTIFY_URL=https://your-webhook/xxx

# ---- 工具调用的模型审查层（没有任何人在回路里点"批准"，故再叠一层模型审查）----
TOOL_GUARD_ENABLED=true
# 审查器判断"这次调用是否安全且对得上眼前对话"。它拿到的是不可信数据，失败时：
#   closed=拒绝（默认，保守）；open=放行（不建议，尤其对 shell）
GUARD_FAIL_MODE=closed
# 审查专用模型；留空则复用上面的 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL
#GUARD_LLM_BASE_URL=https://api.deepseek.com/v1
#GUARD_LLM_API_KEY=sk-xxx
#GUARD_LLM_MODEL=deepseek-v4-flash
GUARD_LLM_TIMEOUT_SECONDS=8
# 需要审查的工具（精确名或前缀通配 fx* / fx:*）；readonly_shell 与所有 MCP 工具默认在列
TOOL_GUARD_TOOLS=readonly_shell
# 提供给审查器的最近对话条数（判断"是否对得上眼前话题"的依据）
GUARD_CONTEXT_MESSAGES=6

# ---- LLM 采样（原先 penalty 拉满 1.0，反而让话更虚；这里改为中等强度）----
LLM_TEMPERATURE=0.9
LLM_TOP_P=0.95
LLM_PRESENCE_PENALTY=0.4
LLM_FREQUENCY_PENALTY=0.6

# ---- 脉搏与打扰程度（下发给 alive-buddy，见 docker-compose.yml）----
# 脉搏间隔：默认 60s（1440 跳/天）。tick 与"是否开口"无关，
# 而主动开口需要几小时没人说话才可能过阈值，所以 5 分钟一跳足够
#PULSE_INTERVAL_MS=300000
# 两次主动发言最小间隔 / 运行状态落盘间隔 / 逐跳详细日志
#PROACTIVE_MIN_INTERVAL_MS=900000
#STATE_SAVE_INTERVAL_MS=300000
#PULSE_VERBOSE=false
# 触发阈值（越高越安静，默认 0.5）
#PROACTIVE_THRESHOLD=0.5

# ---- 记忆与上下文窗口（下发给 alive-buddy）----
MEMORY_L1_CAPACITY=40
MEMORY_CONTEXT_LIMIT=30
MEMORY_MONOLOGUE_BUDGET=1
MEMORY_EPISODE_LIMIT=3
MEMORY_IDLE_SUMMARIZE_MINUTES=120
